<Window x:Class="ExcelMerger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Merger by Shahab Sadeghi" Height="300" Width="450">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Merge mode selector -->
        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="روش ادغام:" Margin="0,0,0,5" FlowDirection="RightToLeft"/>
            <ComboBox x:Name="cmbMergeMode" Width="300">
                <ComboBoxItem Content="ادغام در یک فایل" IsSelected="True"/>
                <ComboBoxItem Content="ادغام در یک برگه"/>
            </ComboBox>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <Button Content="فایل های اکسل را انتخاب کنید" Width="180" Margin="0,0,10,0"
                    Click="BtnSelectFiles_Click"/>
            <Button Content="ادغام و ذخیره" Width="180"
                    Click="BtnMerge_Click"/>
        </StackPanel>

        <!-- Progress bar -->
        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="0,0,0,10">
            <ProgressBar x:Name="progressBar" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="txtProgress" Text="Progress: 0%" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Status log -->
        <TextBox x:Name="txtStatus" Grid.Row="3" 
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 AcceptsReturn="True"/>
    </Grid>
</Window>